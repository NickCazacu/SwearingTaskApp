{
  "name": "roast-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "memes:upload": "wrangler kv key put --binding=ROAST_KV --remote memes --path=memes.json",
    "quotes:upload": "wrangler kv key put --binding=ROAST_KV --remote quotes --path=quotes.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
